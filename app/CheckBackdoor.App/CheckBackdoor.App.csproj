<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CheckBackdoor</AssemblyName>
    <RootNamespace>CheckBackdoor.App</RootNamespace>
    <Product>CheckBackdoor</Product>
    <Version>1.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release builds keep no trace of the build PC: no debug symbols (they hold the source
       path, and with it the user name of whoever builds) and source paths mapped to a neutral one -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- The scan engine (PowerShell) ships next to the app, in the engine\ folder -->
  <ItemGroup>
    <None Include="..\..\CheckBackdoor.ps1" Link="engine\CheckBackdoor.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Actions.ps1" Link="engine\Actions.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\allowlist.json" Link="engine\allowlist.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\modules\*.ps1" Link="engine\modules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The interface: HTML, CSS and JS served to WebView2 from a local folder -->
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
